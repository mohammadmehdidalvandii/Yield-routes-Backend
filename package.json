  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_ORG/yield-routes-backend.git"
  },
  "keywords": ["stellar", "soroban", "defi", "sep-56", "yield-vault", "dex-aggregator"],
  "scripts": {
