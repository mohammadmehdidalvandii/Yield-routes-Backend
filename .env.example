# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3004
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://yieldroutes:yieldroutes@localhost:5432/yieldroutes

# ─── Stellar Network ──────────────────────────────────────────────────────────
# Set to "mainnet" or "testnet". This single var derives the RPC URL and
# network passphrase automatically. Override them individually if needed
# (e.g. to use a custom RPC provider on mainnet).
STELLAR_NETWORK=testnet

# ── Testnet defaults (auto-set when STELLAR_NETWORK=testnet) ──────────────────
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Mainnet (auto-set when STELLAR_NETWORK=mainnet) ───────────────────────────
# Replace YOUR_KEY with a key from https://validationcloud.io or use another
# Soroban RPC provider (Ankr, QuickNode, etc.)
# STELLAR_RPC_URL=https://mainnet.stellar.validationcloud.io/v1/YOUR_KEY
# STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# ─── Contract IDs ─────────────────────────────────────────────────────────────
# Fill in after running: ./scripts/deploy.sh
# Testnet contract IDs:
ROUTE_AGGREGATOR_ID=
YIELD_VAULT_ID=
FEE_DISTRIBUTOR_ID=
PRICE_ORACLE_ID=

# Mainnet contract IDs (set these when STELLAR_NETWORK=mainnet):
# ROUTE_AGGREGATOR_ID=C...
# YIELD_VAULT_ID=C...
# FEE_DISTRIBUTOR_ID=C...
# PRICE_ORACLE_ID=C...

# ─── Vault ────────────────────────────────────────────────────────────────────
# The Stellar Asset Contract address for the vault's underlying token.
# Testnet USDC: deploy via `stellar contract asset deploy --asset USDC:ISSUER`
# Mainnet USDC (Circle): CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
VAULT_UNDERLYING_ASSET=

# ─── Indexer ──────────────────────────────────────────────────────────────────
# Starting ledger for the event indexer. Use the deployment ledger of your
# contracts to avoid scanning the entire chain history.
INDEXER_STARTING_LEDGER=0

# ─── Cron Jobs ────────────────────────────────────────────────────────────────
HARVEST_CRON=0 */6 * * *
PRICE_UPDATE_CRON=*/5 * * * *

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ─── Admin API Key ─────────────────────────────────────────────────────────────
# Optional — if set, mutation endpoints require this header: x-api-key: <value>
# Leave empty to disable auth (dev mode).
ADMIN_API_KEY=
